{
  "name": "jingxin-temple",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "静心寺 — online Buddhist temple web game (MVP prototype)",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "test:sync": "tsx test/sync-test.ts",
    "test:queue": "tsx test/incense-queue-test.ts",
    "test:door": "tsx test/door-test.ts",
    "test:update": "tsx test/update-test.ts",
    "test:world": "tsx test/world-test.ts",
    "test:cross": "tsx test/cross-timing.ts",
    "screenshot": "tsx test/screenshot.ts",
    "screenshot:15": "tsx test/screenshot-round15.ts",
    "screenshot:16": "tsx test/screenshot-round16.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.36",
    "@colyseus/ws-transport": "^0.15.3",
    "colyseus": "^0.15.57",
    "colyseus.js": "^0.15.28",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "three": "^0.170.0",
    "ws": "^8.18.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/three": "^0.170.0",
    "playwright": "^1.65.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
